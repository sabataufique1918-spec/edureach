# ---------- API Gateway ----------
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# ---------- MongoDB ----------
MONGO_URI=mongodb://localhost:27017/edureach

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Object storage (S3 / MinIO) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=edureach-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/edureach-media

# ---------- Media pipeline ----------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_WORK_DIR=./.media-work
TRANSCODE_CONCURRENCY=1

# ---------- Blockchain (Hyperledger Fabric) ----------
# FABRIC_ENABLED=false -> uses the built-in append-only hash-chain ledger
# (same API, no Fabric network needed). Set true once the Fabric network is up.
FABRIC_ENABLED=false
FABRIC_CHANNEL=edureachchannel
FABRIC_CHAINCODE=edureach-cc
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.edureach.local
FABRIC_TLS_CERT_PATH=./fabric/crypto/peer-tls-ca.crt
FABRIC_CERT_PATH=./fabric/crypto/user-cert.pem
FABRIC_KEY_PATH=./fabric/crypto/user-key.pem

# ---------- Analytics service ----------
ANALYTICS_URL=http://localhost:8000
ANALYTICS_TOKEN=analytics-shared-secret

# ---------- Web client ----------
VITE_API_BASE=http://localhost:4000
