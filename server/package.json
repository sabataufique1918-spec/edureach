{
  "name": "edureach-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EduReach API gateway: content, low-bandwidth streaming, offline sync, blockchain credentials",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "worker": "node src/workers/transcode.worker.js",
    "seed": "node src/scripts/seed.js",
    "test": "node test/ledger.test.mjs && node test/sync.test.mjs && node test/auth.test.mjs",
    "sandbox": "node src/scripts/dev-sandbox.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "socket.io": "^4.8.0"
  },
  "optionalDependencies": {
    "@grpc/grpc-js": "^1.11.3",
    "@hyperledger/fabric-gateway": "^1.7.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  },
  "allowScripts": {
    "mongodb-memory-server@11.3.0": true
  }
}
